  "type": "module",
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "check": "node --check v1/app.js && node --check v2/app.js && npm run format:check && node --test",
    "check:e2e": "playwright test",
    "format": "prettier --write \"**/*.{js,mjs,json,yml}\"",
