{
  "name": "color-palette-gen",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-site.mjs && node scripts/check-public-artifact.mjs",
    "check": "node --check v1/app.js && node --check v2/app.js && npm run lint && npm run format:check && npm run test:fast",
    "check:full": "npm run check && npm run test:coverage && npm run test:exhaustive && npm run check:e2e:full",
    "check:e2e": "npm run check:e2e:smoke",
    "check:e2e:smoke": "playwright test --grep @smoke",
    "check:e2e:full": "playwright test",
    "diagnose:adversarial": "node scripts/report-adversarial-diagnostics.mjs",
    "diagnose:feedback-candidates": "node scripts/report-feedback-candidate-availability.mjs",
    "diagnose:mode-range": "node scripts/report-mode-range-counterfactual.mjs",
    "diagnose:pair-ranking": "node scripts/report-pair-ranking-counterfactual.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,mjs,json,yml}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,json,yml}\"",
    "test": "npm run test:fast",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='lib/**/*.js' --test-coverage-include='v2/lib/**/*.js' --test-coverage-include='scripts/check-public-artifact.mjs' --test-coverage-lines=90 --test-coverage-functions=85 --test-coverage-branches=80 test/*.test.js",
    "test:counterfactual": "node --test test/heavy/v2-mode-range-counterfactual.test.js",
    "test:feedback-candidates": "node --test test/heavy/v2-feedback-candidate-availability.test.js",
    "test:pair-ranking-counterfactual": "node --test test/heavy/v2-pair-ranking-counterfactual.test.js",
    "test:fast": "node --test test/*.test.js",
    "test:exhaustive": "node --test test/exhaustive/*.test.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "apca-w3": "0.1.9",
    "eslint": "^10.8.1",
    "prettier": "3.9.6"
  }
}
